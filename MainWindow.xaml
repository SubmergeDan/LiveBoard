                            <Slider x:Name="IntervalSlider" Minimum="1" Maximum="120" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource SoftSlider}" Template="{StaticResource SoftSliderTemplate}" ValueChanged="IntervalSlider_OnChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="MuxRightPanel" Grid.Column="4" Visibility="Collapsed">
                    <TextBlock Text="任务" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Medium" Margin="2,0,0,12" />
                    <Border Background="{StaticResource DarkPanelBrush}" CornerRadius="18" Padding="20" MinHeight="310">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="缓存导出" Foreground="#B5C1BA" FontSize="13" />
                                <TextBlock x:Name="MuxTaskStateText" Text="待命" Foreground="{StaticResource BrightGreenBrush}" FontSize="13" HorizontalAlignment="Right" FontWeight="Medium" />
                            </Grid>
                            <Border Height="1" Background="#2B3B35" Margin="0,16,0,14" />
                            <TextBlock Text="视频轨道" Foreground="#AABAB2" FontSize="10" />
                            <TextBlock x:Name="MuxTaskVideoText" Text="尚未选择" Foreground="White" FontSize="11" Margin="0,5,0,14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="音频轨道" Foreground="#AABAB2" FontSize="10" />
                            <TextBlock x:Name="MuxTaskAudioText" Text="尚未选择" Foreground="White" FontSize="11" Margin="0,5,0,14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="导出文件" Foreground="#AABAB2" FontSize="10" />
                            <TextBlock x:Name="MuxTaskOutputText" Text="尚未设置" Foreground="White" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="20" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="封装信息" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium" />
                            <Grid Margin="0,17,0,0">
                                <TextBlock Text="视频轨道" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="COPY" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <TextBlock Text="音频轨道" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="COPY" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <TextBlock Text="输出容器" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="MP4" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="MediaRightPanel" Grid.Column="4" Visibility="Collapsed">
                    <TextBlock Text="任务" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Medium" Margin="2,0,0,12" />
                    <Border Background="{StaticResource DarkPanelBrush}" CornerRadius="18" Padding="20" MinHeight="310">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="媒体导出" Foreground="#B5C1BA" FontSize="13" />
                                <TextBlock x:Name="MediaTaskStateText" Text="待命" Foreground="{StaticResource BrightGreenBrush}" FontSize="13" HorizontalAlignment="Right" FontWeight="Medium" />
                            </Grid>
                            <Border Height="1" Background="#2B3B35" Margin="0,16,0,14" />
                            <TextBlock Text="平台" Foreground="#AABAB2" FontSize="10" />
                            <TextBlock x:Name="MediaTaskPlatformText" Text="尚未识别" Foreground="White" FontSize="11" Margin="0,5,0,14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="内容" Foreground="#AABAB2" FontSize="10" />
                            <TextBlock x:Name="MediaTaskTitleText" Text="尚未解析" Foreground="White" FontSize="11" Margin="0,5,0,14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="保存位置" Foreground="#AABAB2" FontSize="10" />
                            <TextBlock x:Name="MediaTaskOutputText" Text="尚未设置" Foreground="White" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="20" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="平台支持" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium" />
                            <Grid Margin="0,17,0,0">
                                <TextBlock Text="抖音" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="视频 / 图集" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <TextBlock Text="Bilibili" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="动态画质" Foreground="#00A1D6" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <TextBlock Text="快手" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="视频" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <TextBlock Text="X / Instagram" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="视频 / 多图" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
